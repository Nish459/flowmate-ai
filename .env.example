# Copy this file to .env and fill in real values. Never commit .env.

GCP_PROJECT_ID=flowmate-ai-506118
GCP_LOCATION=us-central1

BQ_DATASET=flowmate
BQ_TICKETS_TABLE=tickets
BQ_PR_REVIEWS_TABLE=pr_reviews
BQ_TEAM_VELOCITY_TABLE=team_velocity

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Comma-separated origins allowed to call this API from a browser (the React
# frontend's dev server, later its deployed Firebase Hosting URL).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Shared code required (X-Access-Code header) by the endpoints that spend Gemini
# quota or rewrite cached data: POST /scan, GET /panels, POST /standups/snapshot,
# POST /standups/{engineer}/generate. Leave empty locally to skip the check; the
# deployed service reads it from Secret Manager (flowmate-access-code).
ACCESS_CODE=
